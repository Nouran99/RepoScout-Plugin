# RepoScout MCP Plugin Environment Example
# Copy to `.env` and set values as needed.
# Plugin can run in anonymous mode if no token/key is provided.

# SECURITY-CRITICAL
# Format example: github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# SECURITY-CRITICAL
# Format example: rs_live_xxxxxxxxxxxxxxxxxxxxxxxxx
REPOSCOUT_API_KEY=

REPOSCOUT_BACKEND_URL=https://reposcout-api.nouran-darwish-ai.dev

# License backend outage policy:
# false -> block requests with actionable outage guidance (production default)
# true  -> allow requests when backend is unreachable (local development only)
REPOSCOUT_LICENSE_FAIL_OPEN=false
